{
  "name": "ldes-lms",
  "version": "1.0.0",
  "description": "Library Management System",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ldes.lms",
    "productName": "LDES-LMS",
    "win": {
      "target": "nsis",
      "icon": "static/assets/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "dist/flask",
        "to": "flask",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "electron/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  }
}